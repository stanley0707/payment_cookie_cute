# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# --- App ---
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=pcc_db
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_ECHO=false

# --- RabbitMQ (единые имена!) ---
RABBITMQ_USER=test-user
RABBITMQ_PASS=test-user
RABBITMQ_HOST=pcc_rabbitmq
RABBITMQ_PORT=5672

# --- App config ---
PCC_PROFILE=development
PCC_API_KEY=dev-secret-key
PCC_WEBHOOK_TIMEOUT=10
PCC_WEBHOOK_MAX_RETRIES=3
